{
  "supabase_url": "https://CHANGE-test-project.supabase.co",
  "supabase_anon_key": "CHANGE-the-test-project-publishable-key (public by design)",
  "send_token_as": "bearer",
  "tenant_column": "tenant_id",
  "tenants": {
    "A": {
      "id": "CHANGE-tenant-a-uuid",
      "marker": "CHANGE-text-that-only-exists-in-tenant-A-test-data"
    },
    "B": {
      "id": "CHANGE-tenant-b-uuid",
      "marker": "CHANGE-text-that-only-exists-in-tenant-B-test-data"
    }
  },
  "users": {
    "a_admin": {
      "tenant": "A",
      "role": "admin",
      "password_secret": "MGE_TEST_PASSWORD",
      "email": "a_admin@CHANGE-test.example.com"
    },
    "a_member": {
      "tenant": "A",
      "role": "member",
      "password_secret": "MGE_TEST_PASSWORD",
      "email": "a_member@CHANGE-test.example.com"
    },
    "b_admin": {
      "tenant": "B",
      "role": "admin",
      "password_secret": "MGE_TEST_PASSWORD",
      "email": "b_admin@CHANGE-test.example.com"
    }
  },
  "checks": [
    {
      "as": "a_admin",
      "method": "GET",
      "path": "/api/CHANGE/tenant-a-record-id",
      "expect": "allowed"
    },
    {
      "as": "a_admin",
      "method": "GET",
      "path": "/api/CHANGE/tenant-b-record-id",
      "against": "B",
      "expect": "denied"
    },
    {
      "as": null,
      "method": "GET",
      "path": "/api/CHANGE/tenant-a-record-id",
      "against": "A",
      "expect": "denied"
    }
  ],
  "database_check": false,
  "tenant_routes": {
    "files": [
      "apps/api/src"
    ],
    "param": ":tenantId",
    "prefix": "/api",
    "as": "a_admin",
    "against": "B"
  },
  "scan_as": "a_admin"
}
