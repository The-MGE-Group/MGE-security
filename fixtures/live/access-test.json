{
  "supabase_url": "http://localhost:8080",
  "supabase_anon_key_secret": "FIXTURE_ANON_KEY",
  "send_token_as": {"cookie": "sb-fixture-auth-token"},
  "routes_dir": "fixtures/live/app",
  "tenants": {
    "A": {"id": "11111111-1111-1111-1111-111111111111", "marker": "ZZ-TENANT-A-REPORT"},
    "B": {"id": "22222222-2222-2222-2222-222222222222", "marker": "ZZ-TENANT-B-REPORT"}
  },
  "users": {
    "a_admin": {"tenant": "A", "role": "admin", "email_secret": "FIXTURE_A_ADMIN_EMAIL", "password_secret": "FIXTURE_PASSWORD"},
    "a_member": {"tenant": "A", "role": "member", "email_secret": "FIXTURE_A_MEMBER_EMAIL", "password_secret": "FIXTURE_PASSWORD"},
    "b_admin": {"tenant": "B", "role": "admin", "email_secret": "FIXTURE_B_ADMIN_EMAIL", "password_secret": "FIXTURE_PASSWORD"}
  },
  "checks": [
    {"as": "a_admin", "method": "GET", "path": "/api/reports/1", "expect": "allowed"},
    {"as": "b_admin", "method": "GET", "path": "/api/reports/2", "expect": "allowed"},
    {"as": "a_admin", "method": "GET", "path": "/api/reports/2", "against": "B", "expect": "denied"},
    {"as": "b_admin", "method": "GET", "path": "/api/reports/1", "against": "A", "expect": "denied"},
    {"as": null, "method": "GET", "path": "/api/reports/1", "against": "A", "expect": "denied"},
    {"as": "a_member", "method": "DELETE", "path": "/api/reports/1", "against": "A", "expect": "denied"}
  ]
}
